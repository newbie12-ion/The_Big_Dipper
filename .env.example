VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# OpenRouter — powers the crop scanner's vision diagnosis.
# Get a key at https://openrouter.ai/keys
#
# The model MUST accept image input. Text-only models (e.g.
# nvidia/nemotron-3-ultra-550b-a55b:free) will reject every scan.
# Free vision-capable options: google/gemma-4-31b-it:free,
# google/gemma-4-26b-a4b-it:free, nvidia/nemotron-nano-12b-v2-vl:free.
#
# NOTE: Vite inlines VITE_* vars into the client bundle, so this key is public
# to anyone who opens the site. Use a throwaway free-tier key, and move the call
# behind a Supabase edge function before any real deployment.
VITE_OPENROUTER_API_KEY=your-openrouter-api-key
VITE_OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Tried in order when the primary is rate-limited (429), errors upstream, or
# returns unparseable JSON. Every entry must accept image input.
VITE_OPENROUTER_FALLBACKS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
